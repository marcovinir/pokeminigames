# Copia este archivo a server/.env y ajusta los valores. server/.env no se sube a git.

NODE_ENV=development
PORT=3000

# Base de datos de desarrollo. Cambia CAMBIA_ESTA_CLAVE por la contraseña de tu PostgreSQL local.
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/pokemon_minigames

# Mínimo 32 caracteres. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12

# Origen del frontend (Vite) que puede llamar a la API con cookies.
CORS_ORIGIN=http://localhost:5173

# En producción con frontend y backend en dominios distintos: COOKIE_SECURE=true y COOKIE_SAME_SITE=none.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
