# Copia este archivo a server/.env.test y ajusta la contraseña. server/.env.test no se sube a git.
# Las pruebas BORRAN datos: usa una base de datos distinta a la de desarrollo.

NODE_ENV=test
DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CLAVE@localhost:5432/pokemon_minigames_test
JWT_ACCESS_SECRET=clave-solo-para-pruebas-0123456789-abcdefghij
# Costo mínimo de bcrypt para que las pruebas sean rápidas.
BCRYPT_COST=4
